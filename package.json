{
  "name": "ihsan-pay-lab",
  "version": "1.0.0",
  "description": "Non-custodial wallet integration and Solana devnet payments reference application",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "wallet:create": "tsx --env-file=.env.local scripts/create-wallets.ts",
    "seed": "tsx --env-file=.env.local scripts/seed-host.ts",
    "webhook:register": "tsx --env-file=.env.local scripts/register-webhook.ts",
    "setup:check": "tsx --env-file=.env.local scripts/check-setup.ts",
    "format": "prettier --write src scripts tests *.ts *.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@privy-io/react-auth": "^3.50.0",
    "@solana-program/memo": "^0.10.0",
    "@solana/kit": "^5.5.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@supabase/supabase-js": "^2.118.0",
    "bs58": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
